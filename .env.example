# Copy to .env and fill in. .env is gitignored - never commit a real token.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#   python3 scripts/gen_progress.py --list

# Personal access token from Solidtime: profile menu -> API tokens -> create.
# Solidtime tokens are unscoped and carry full read/write on your account, so
# treat this as a password. Name it "chirp-progress-page" so it can be revoked
# on its own, and revoke it at the same screen if it ever leaks.
SOLIDTIME_TOKEN=

# Solidtime instance. Only override to point at a different deployment.
SOLIDTIME_URL=https://solidtime.zestdev.uk

# Organization UUID. Leave empty unless the token belongs to more than one
# organization - the script resolves it from /v1/users/me/memberships and will
# print the available IDs if the choice is ambiguous.
SOLIDTIME_ORG=
